# bsc — environment. Copy to /etc/bsc/bsc.env and lock it down:
#   chown root:bsc /etc/bsc/bsc.env && chmod 640 /etc/bsc/bsc.env
#
# Everything below is optional except MASTER_SECRET. The values shown are the
# built-in defaults, except DB_PATH and SNAPSHOT_DIR — those are deployment
# choices this file makes for you (snapshots are off by default; turn them on).
# A handful of these also have command-line flags (bsc --help) that override the
# environment for a one-off run. Full notes: ../README.md

# ─── required ────────────────────────────────────────────────────────────────
# 32-byte hex. Signs every transaction, pays all gas, and holds an unlimited
# allowance on every wallet this service derives — whoever has it can move every
# app's funds. Keep it in a secrets manager; never in the database, never in git.
MASTER_SECRET=

# ─── storage ─────────────────────────────────────────────────────────────────
# The only datastore: one bbolt file holding apps and their ledgers, wallets,
# deposits, withdrawals and in-flight work.
DB_PATH=/var/lib/bsc/bsc.db

# Self-backup. Unset disables it — set it. Losing this file loses the wallet
# UUIDs, and without those every derived address is unrecoverable even though
# you still hold MASTER_SECRET. Ship snapshots off the machine.
SNAPSHOT_DIR=/var/backups/bsc
SNAPSHOT_INTERVAL=1h
SNAPSHOT_KEEP=24

# ─── listener ────────────────────────────────────────────────────────────────
# The only listener, and there is no authentication: an app's slug in the path
# is identity, not a credential. Keep it on loopback and never proxy it publicly.
HTTP_ADDR=127.0.0.1:8800

# ─── chain ───────────────────────────────────────────────────────────────────
# The endpoint is the one chain setting. bsc asks it for eth_chainId after
# connecting, and the token, the swap router and the id every signature is bound
# to all follow that answer — so a testnet run needs only this line changed:
#
#   RPC_URL=wss://bsc-testnet-rpc.publicnode.com
#
# There is deliberately no CHAIN_ID. It could disagree with the endpoint, and a
# mismatch is invisible and total: the watcher reads blocks perfectly while every
# transaction is rejected for being signed against the wrong chain. The detected
# chain is recorded in the database and refused if it ever changes.
RPC_URL=wss://bsc-rpc.publicnode.com

# Override only to use your own ERC-20. Defaults to the USDT deployment for
# whichever chain the endpoint turns out to be. Any token with at least two
# decimals works; the cent scale is read from the contract.
# TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Requests per second, shared by the block watcher and the signing path alike.
# At ~0.45s blocks the watcher needs ~2.2/s just to keep pace and must outrun the
# chain to recover from downtime: at 20/s an hour of downtime clears in about
# seven minutes, at 5/s a day's outage would take half a day. Refused below 5.
RPC_RATE_LIMIT=20

# Only used on a fresh database. 0 means "the current finalized head" — never
# genesis, which would be an unbounded scan.
START_BLOCK=0

# How often the head is polled once caught up. While behind there is no sleep at
# all, and blocks are folded in batches of BACKFILL_BATCH per write transaction —
# bigger batches mean fewer, larger commits when recovering from downtime.
POLL_INTERVAL=500ms
BACKFILL_BATCH=100

# Withdrawals are refused (503) past this much lag, because the ledger is only
# current at the head: a drain that settled in an unprocessed block has not been
# credited yet. Reads keep working throughout.
MAX_LAG_BLOCKS=200

# ─── money ───────────────────────────────────────────────────────────────────
# An app's balance is an internal ledger in CENTS — credited deposits less
# settled withdrawals — not its hot wallet's chain balance. Deposits are floored
# to the cent on arrival and the remainder stays with the house, along with the
# fees. See ../../docs/CONSUMING.md.

# Pure gas economics: don't spend a transaction moving less than this out of a
# deposit address. It does NOT decide what an app is credited — anything worth a
# whole cent is recorded immediately and shows as `pending` until the drain is
# worth running. Default 1 USDT.
DRAIN_THRESHOLD_WEI=1000000000000000000

# A newly registered app's withdrawal fee, which it may then change itself. A
# business fee charged to the app's own users, unrelated to gas. $1.00.
DEFAULT_FEE_CENTS=100

# The fee never moves on its own: it leaves the app's ledger with the payout and
# stays in the wallet as ours. This is how much a wallet must hold ABOVE its
# app's ledger — fees, sub-cent dust, stray transfers — before one transfer is
# worth collecting it. 0 disables sweeping; the money is still ours and simply
# accumulates. $1.00.
HOUSE_SWEEP_MIN_CENTS=100

# Where the house's money lands. Empty means the master wallet.
FEE_COLLECTOR=

# ─── gas ─────────────────────────────────────────────────────────────────────
# The only gas knobs: amounts are estimated, never configured. Keep the funding
# multiplier modest — unused gas is refunded, so the surplus stays as dust in
# each deposit wallet forever.
FUNDING_MULTIPLIER=1.25
GAS_PRICE_MULTIPLIER=1.10

# How long before an unconfirmed transaction is re-sent. It is always the same
# signed bytes: a transaction that may have been broadcast is never re-signed,
# because that could double-spend if the original later mines.
REBROADCAST_AFTER=2m

# How often the master's balances are refreshed. This is not only a gauge: it is
# the moment the gas top-up below is evaluated, because the native balance is the
# one number the service cannot derive for itself — inbound native transfers emit
# no log. A dry master stops every pipeline.
MASTER_POLL=30s

# ─── gas top-ups ─────────────────────────────────────────────────────────────
# When the master's native balance falls below the floor and it holds enough
# collected fees, it trades SWAP_AMOUNT_WEI of them for gas through the router:
# the fees the withdrawals earned pay for the gas the withdrawals cost.
#
# It can only sell fees it actually holds, so this is not a substitute for
# watching bsc_master_bnb_wei — a quiet stretch with no withdrawals leaves a
# draining master with nothing to trade.
SWAP_ENABLED=true
SWAP_AMOUNT_WEI=10000000000000000000
GAS_FLOOR_WEI=50000000000000000

# 1%. The swap is the only operation whose outcome is a price rather than a yes
# or no, so it is the only one with a slippage bound.
SWAP_SLIPPAGE_BPS=100

# Minimum gap between attempts, and the bound on a losing loop: a swap that
# succeeds without lifting the balance above the floor would otherwise re-fire
# immediately and keep trading fees away until there were none left.
SWAP_COOLDOWN=1h

# A Uniswap-V2-interface router. Defaults to the verified PancakeSwap V2
# deployment for the detected chain; a chain with no default must name one here
# or set SWAP_ENABLED=false. The wrapped-native token is asked of the router
# itself, so the two cannot disagree — override only for a fork that names the
# accessor something other than WETH().
# SWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
# SWAP_WRAPPED_NATIVE=

# ─── logging ─────────────────────────────────────────────────────────────────
# Structured JSON to stderr. debug | info | warn | error
LOG_LEVEL=info
