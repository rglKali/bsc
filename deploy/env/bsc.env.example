# bsc — environment. Copy to /etc/bsc/bsc.env and lock it down:
#   chown root:bsc /etc/bsc/bsc.env && chmod 640 /etc/bsc/bsc.env
#
# Everything below is optional except MASTER_SECRET. Defaults are shown; a
# handful of these also have command-line flags (bsc --help) that override the
# environment for a one-off run. Full notes: ../README.md

# ─── required ────────────────────────────────────────────────────────────────
# 32-byte hex. Signs every transaction, pays all gas, and holds an unlimited
# allowance on every wallet this service derives — whoever has it can move every
# app's funds. Keep it in a secrets manager; never in the database, never in git.
MASTER_SECRET=

# ─── storage ─────────────────────────────────────────────────────────────────
# The only datastore: one bbolt file holding apps, wallets, deposits,
# withdrawals and in-flight work.
DB_PATH=/var/lib/bsc/bsc.db

# Self-backup. Unset disables it — set it. Losing this file loses the wallet
# UUIDs, and without those every derived address is unrecoverable even though
# you still hold MASTER_SECRET. Ship snapshots off the machine.
SNAPSHOT_DIR=/var/backups/bsc
SNAPSHOT_INTERVAL=1h
SNAPSHOT_KEEP=24

# ─── listener ────────────────────────────────────────────────────────────────
# The only listener, and there is no authentication: an app's slug in the path
# is identity, not a credential. Keep it on loopback and never proxy it publicly.
HTTP_ADDR=127.0.0.1:8800

# ─── chain ───────────────────────────────────────────────────────────────────
# The chain id is the one setting the others follow. The endpoint, the token and
# the swap router all default from it, so a testnet run needs only CHAIN_ID=97.
# Anything set here still wins — these are defaults, not policy.
CHAIN_ID=56
# RPC_URL=wss://bsc-rpc.publicnode.com
# TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Requests per second, shared by the block watcher and the signing path alike.
# At ~0.45s blocks the watcher needs ~2.2/s just to keep pace and must outrun the
# chain to recover from downtime: at 20/s an hour of downtime clears in about
# seven minutes, at 5/s a day's outage would take half a day. Refused below 5.
RPC_RATE_LIMIT=20

# Only used on a fresh database. 0 means "the current finalized head" — never
# genesis, which would be an unbounded scan.
START_BLOCK=0

POLL_INTERVAL=500ms
BACKFILL_BATCH=100

# Withdrawals are refused (503) past this much lag, because balances are only
# current at the head and reserving against a stale one could overdraw an app.
# Reads keep working throughout.
MAX_LAG_BLOCKS=200

# ─── money ───────────────────────────────────────────────────────────────────
# Transfers below this are credited to the balance but never recorded as
# deposits; the same figure gates the drain trigger, applied to a wallet's total,
# so ignored dust is never lost — only unannounced. Default 1 USDT.
MIN_DEPOSIT_WEI=1000000000000000000

# A newly registered app's withdrawal fee, which it may then change itself.
# This is a business fee charged to the app's own users, unrelated to gas.
DEFAULT_FEE_WEI=1000000000000000000

# Where swept fees land. Empty means the master wallet.
FEE_COLLECTOR=

# Fees accrue off-chain and sweep in batch — that is what makes a withdrawal one
# on-chain transfer instead of two. A sweep is due at the threshold, or when the
# oldest unswept fee has waited out the interval.
FEE_SWEEP_THRESHOLD=10000000000000000000
FEE_SWEEP_INTERVAL=24h

# ─── gas ─────────────────────────────────────────────────────────────────────
# The only gas knobs: amounts are estimated, never configured. Keep the funding
# multiplier modest — unused gas is refunded, so the surplus stays as dust in
# each deposit wallet forever.
FUNDING_MULTIPLIER=1.25
GAS_PRICE_MULTIPLIER=1.10

# How long before an unconfirmed transaction is re-sent. It is always the same
# signed bytes: a transaction that may have been broadcast is never re-signed,
# because that could double-spend if the original later mines.
REBROADCAST_AFTER=2m

# How often the master BNB gauge refreshes. Inbound native transfers emit no log,
# so this is the one number the service cannot derive for itself — and a dry
# master stops every pipeline.
MASTER_POLL=30s

# ─── logging ─────────────────────────────────────────────────────────────────
# Structured JSON to stderr. debug | info | warn | error
LOG_LEVEL=info
